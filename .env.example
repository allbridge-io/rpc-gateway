CONFIG_TOML_PATH=./config.local.toml
#SECRET_CONFIG_TOML_PATH=./config.secret.local.toml   # OPTIONAL, merged on top of CONFIG_TOML_PATH
#CONFIG_TOML_SECTION=rpc_gateway                       # OPTIONAL, when the TOML is shared with other services
#CONFIG_OVERRIDE_TOML='[server]\nport = 4000'          # OPTIONAL, inline TOML merged last
#PORT=3000                                             # OPTIONAL, overrides server.port (Render sets it)

# Values referenced from the TOML as ${NAME}
#RPC_GATEWAY_API_KEY=            # the gateway's own key (server.api_keys), openssl rand -hex 32
#ALCHEMY_KEY=

# ============= LOGGER ==================
LOG_LEVEL=info                  # debug, info, warn, error (debug also logs every request)
LOG_FORMAT=console              # console for humans, json for Render/Grafana

# ============= OTLP -> Grafana Cloud (optional) ==================
# Leave OTEL_EXPORTER_OTLP_ENDPOINT unset to disable. Values come from the
# Grafana Cloud stack: Connections > OpenTelemetry (OTLP) > Configure.
#OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
#OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 of instanceId:token>
#OTEL_SERVICE_NAME=rpc-gateway
#OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev
#OTEL_METRIC_EXPORT_INTERVAL=60000   # ms
#OTLP_LOG_LEVEL=info                 # minimum level of log lines exported (stdout keeps LOG_LEVEL)
