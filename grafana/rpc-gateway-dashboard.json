{
  "uid": "rpc-gateway",
  "title": "RPC Gateway",
  "description": "Health and traffic of the multi-chain RPC gateway. Environment picks prod or dev (deployment.environment). Import into Grafana Cloud and pick the Prometheus and Loki data sources of your stack.",
  "tags": [
    "rpc-gateway",
    "allbridge"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 6,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "ds_prom",
        "label": "Metrics source",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": ""
      },
      {
        "type": "datasource",
        "name": "ds_loki",
        "label": "Logs source",
        "query": "loki",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": ""
      },
      {
        "type": "query",
        "name": "env",
        "label": "Environment",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prom}"
        },
        "definition": "label_values(rpc_gateway_target_routable, deployment_environment)",
        "query": {
          "qryType": 1,
          "query": "label_values(rpc_gateway_target_routable, deployment_environment)",
          "refId": "env"
        },
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "prod",
          "value": "prod"
        },
        "hide": 0,
        "sort": 1
      },
      {
        "type": "query",
        "name": "chain",
        "label": "Chain",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prom}"
        },
        "definition": "label_values(rpc_gateway_target_routable{deployment_environment=\"$env\"}, chain)",
        "query": {
          "qryType": 1,
          "query": "label_values(rpc_gateway_target_routable{deployment_environment=\"$env\"}, chain)",
          "refId": "chain"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Targets",
      "description": "One row per upstream target. State is the final verdict the router uses: OK is routable, DOWN is enabled but failing its checks, OFF is disabled in the config on purpose. Lag is how many blocks behind the best target of the same chain.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rpc_gateway_target_routable{deployment_environment=\"$env\",chain=~\"$chain\"} + 2 * rpc_gateway_target_disabled{deployment_environment=\"$env\",chain=~\"$chain\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "rpc_gateway_target_block_number{deployment_environment=\"$env\",chain=~\"$chain\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "rpc_gateway_target_lag{deployment_environment=\"$env\",chain=~\"$chain\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 10,
        "h": 16
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(chain|target|Value #[ABC])$"
            }
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "renameByName": {
              "chain": "Chain",
              "target": "Target",
              "Value #A": "State",
              "Value #B": "Block",
              "Value #C": "Lag"
            },
            "indexByName": {
              "chain": 0,
              "target": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Chain"
              },
              {
                "field": "Target"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "DOWN",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "OK",
                        "color": "green",
                        "index": 1
                      },
                      "2": {
                        "text": "OFF",
                        "color": "#8e8e8e",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Block"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 140
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Lag"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 20
                    },
                    {
                      "color": "red",
                      "value": 100
                    }
                  ]
                }
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Chain"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Requests per second",
      "description": "Attempts to forward a request, split by chain and outcome.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (chain) (rate(rpc_gateway_upstream_requests_total{deployment_environment=\"$env\",chain=~\"$chain\",outcome=\"ok\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series",
          "legendFormat": "{{chain}} ok"
        },
        {
          "refId": "B",
          "expr": "sum by (chain) (rate(rpc_gateway_upstream_requests_total{deployment_environment=\"$env\",chain=~\"$chain\",outcome=\"error\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series",
          "legendFormat": "{{chain}} error"
        }
      ],
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 10,
        "h": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMax": 1
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Routable targets per chain",
      "description": "How many targets of each chain may receive requests right now, out of how many are enabled (3 / 3 = all three enabled targets are routable; targets disabled in the config are not counted). A partly filled bar means some targets are down; red means the chain has none left and answers 503.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(sum by (chain) (rpc_gateway_target_routable{deployment_environment=\"$env\",chain=~\"$chain\"}) * on (chain) group_left(total) count_values by (chain) (\"total\", count by (chain) (rpc_gateway_target_routable{deployment_environment=\"$env\",chain=~\"$chain\"} unless rpc_gateway_target_disabled{deployment_environment=\"$env\",chain=~\"$chain\"} == 1)), \"unit\", \"/ $1\", \"total\", \"(.+)\")",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 16
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(chain|total|unit|Value)$"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "chain"
              }
            ]
          }
        },
        {
          "id": "rowsToFields",
          "options": {
            "mappings": [
              {
                "fieldName": "chain",
                "handlerKey": "field.name"
              },
              {
                "fieldName": "Value",
                "handlerKey": "field.value"
              },
              {
                "fieldName": "total",
                "handlerKey": "max"
              },
              {
                "fieldName": "unit",
                "handlerKey": "unit"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "thresholds": {
            "mode": "percentage",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "minVizHeight": 16,
        "minVizWidth": 8,
        "valueMode": "color"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Reroutes, taints and outages",
      "description": "Reroute: a request failed on a target and was retried elsewhere. Taint: the target was excluded for a while. No healthy: nothing was left to try, the client got a 503.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (chain, target) (rate(rpc_gateway_reroutes_total{deployment_environment=\"$env\",chain=~\"$chain\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series",
          "legendFormat": "reroute {{chain}}/{{target}}"
        },
        {
          "refId": "B",
          "expr": "sum by (chain, target) (rate(rpc_gateway_target_taints_total{deployment_environment=\"$env\",chain=~\"$chain\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series",
          "legendFormat": "taint {{chain}}/{{target}}"
        },
        {
          "refId": "C",
          "expr": "sum by (chain) (rate(rpc_gateway_no_healthy_targets_total{deployment_environment=\"$env\",chain=~\"$chain\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series",
          "legendFormat": "NO HEALTHY {{chain}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMax": 1
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Upstream latency p95",
      "description": "95th percentile of one attempt to a target.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, chain) (rate(rpc_gateway_upstream_duration_seconds_bucket{deployment_environment=\"$env\",chain=~\"$chain\"}[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series",
          "legendFormat": "{{chain}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Errors by method",
      "description": "Which JSON-RPC method fails on which target, over the dashboard's time range. Errors and Requests are counts for the range; Error % is their ratio. Rows without errors are hidden. The same answer as typing sum by (chain, target, method) (rate(...{outcome=\"error\"})) in Explore.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (chain, target, method) (increase(rpc_gateway_upstream_requests_total{deployment_environment=\"$env\",chain=~\"$chain\",outcome=\"error\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "sum by (chain, target, method) (increase(rpc_gateway_upstream_requests_total{deployment_environment=\"$env\",chain=~\"$chain\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "100 * sum by (chain, target, method) (increase(rpc_gateway_upstream_requests_total{deployment_environment=\"$env\",chain=~\"$chain\",outcome=\"error\"}[$__range])) / sum by (chain, target, method) (increase(rpc_gateway_upstream_requests_total{deployment_environment=\"$env\",chain=~\"$chain\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 10
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(chain|target|method|Value #[ABC])$"
            }
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterByValue",
          "options": {
            "filters": [
              {
                "fieldName": "Value #A",
                "config": {
                  "id": "greater",
                  "options": {
                    "value": 0
                  }
                }
              }
            ],
            "type": "include",
            "match": "all"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "renameByName": {
              "chain": "Chain",
              "target": "Target",
              "method": "Method",
              "Value #A": "Errors",
              "Value #B": "Requests",
              "Value #C": "Error %"
            },
            "indexByName": {
              "chain": 0,
              "target": 1,
              "method": 2,
              "Value #A": 3,
              "Value #B": 4,
              "Value #C": 5
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Errors",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Chain"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Target"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Error %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 5
                    },
                    {
                      "color": "red",
                      "value": 50
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Errors"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Requests"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Error rate by target",
      "description": "Failed attempts per second, one line per target. Flat at zero is healthy; a spike shows when a target was failing and how hard. Split by method in the table on the left.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (chain, target) (rate(rpc_gateway_upstream_requests_total{deployment_environment=\"$env\",chain=~\"$chain\",outcome=\"error\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series",
          "legendFormat": "{{chain}} {{target}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
